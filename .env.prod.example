# Modelo do .env.prod de PRODUÇÃO (etapa 09). O arquivo real vive SÓ no servidor:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# Guarde uma cópia no cofre de senhas do dono (sem ela, não há como restaurar os backups).
# Gere segredos com:  openssl rand -base64 48

# ---------------------------------------------------------------- versão e domínio
# Tag da imagem no GHCR (git tag v1.2.3 → 1.2.3; ou sha-abc1234). O scripts/deploy.sh atualiza.
TAG=<TAG>
DOMINIO=<DOMINIO>
# E-mail para o Let's Encrypt. Teste local: CADDY_TLS=internal
CADDY_TLS=<EMAIL_DO_RESPONSAVEL>
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- bancos (nunca expostos)
MYSQL_USER=petconnect
MYSQL_PASSWORD=<SEGREDO>
MYSQL_ROOT_PASSWORD=<SEGREDO>
MONGO_USER=petconnect
MONGO_PASSWORD=<SEGREDO>

# ---------------------------------------------------------------- aplicação
# >= 32 bytes. Trocar derruba todas as sessões (ver docs/runbooks/rotacao-segredos.md).
JWT_SECRET=<SEGREDO>
# Primeiro ADMIN (só é criado se não existir nenhum). Troque a senha no primeiro acesso.
ADMIN_USERNAME=<USUARIO_ADMIN>
ADMIN_EMAIL=<EMAIL_ADMIN>
ADMIN_PASSWORD=<SEGREDO_COM_POLITICA>

# SMTP real (recuperação de senha).
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USERNAME=<SMTP_USUARIO>
SMTP_PASSWORD=<SEGREDO>
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_REMETENTE=PetConnect <nao-responda@<DOMINIO>>

# ---------------------------------------------------------------- operação
# Usuário técnico (papel VENDAS) usado só pelo smoke test pós-deploy.
SMOKE_USERNAME=smoke.deploy
SMOKE_PASSWORD=<SEGREDO_COM_POLITICA>
# Backups cifrados: SEM ESTA FRASE NÃO HÁ RESTORE. Guarde no cofre.
BACKUP_PASSPHRASE=<SEGREDO>
BACKUP_DIR=/opt/petconnect/backups
# Opcional: cópia off-site com rclone (ex.: remoto:petconnect-backups). Vazio = só local.
BACKUP_REMOTO=
# Opcional: webhook (Discord/Slack/Telegram) para os alertas do scripts/monitorar.sh.
ALERTA_WEBHOOK_URL=
