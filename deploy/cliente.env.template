# Modelo do .env.prod de UMA instalação (etapa 08). NÃO contém segredo: o scripts/cliente.sh substitui os @marcadores@.
# Quem gera o arquivo real é `scripts/cliente.sh novo <id> ...`; ele fica em clientes/<id>/.env.prod (chmod 600, fora do git).
# Cada instalação tem os SEUS segredos. Repetir JWT_SECRET, senha de banco ou frase de backup entre clientes é erro
# (o `cliente.sh validar` e o `cliente.sh isolamento` recusam).

# ---------------------------------------------------------------- identidade (não sensível)
# Identificador curto: minúsculas, números e hífen. Vira o nome do projeto Compose (petconnect-<id>).
INSTALACAO_ID=@ID@
DOMINIO=@DOMINIO@
# E-mail do Let's Encrypt, ou "internal" (certificado local de teste/homologação).
CADDY_TLS=@TLS@
# Em produção com vários clientes no mesmo host: um IP por cliente (BIND_IP) mantendo 80/443. Homologação: portas distintas.
BIND_IP=@BIND_IP@
HTTP_PORT=@HTTP_PORT@
HTTPS_PORT=@HTTPS_PORT@
TAG=@TAG@

# ---------------------------------------------------------------- módulos contratados (etapa 07)
# `todos` ou lista de ids do catálogo (docs/implementacao/06_CATALOGO_MODULOS.md). Mudar: scripts/cliente.sh modulos <id> <lista>.
PETCONNECT_MODULOS=@MODULOS@
PETCONNECT_ESTOQUE_LOTES=false

# ---------------------------------------------------------------- bancos (nunca expostos; um par por instalação)
MYSQL_USER=petconnect
MYSQL_PASSWORD=@GERAR@
MYSQL_ROOT_PASSWORD=@GERAR@
MONGO_USER=petconnect
MONGO_PASSWORD=@GERAR@

# ---------------------------------------------------------------- aplicação
JWT_SECRET=@GERAR@
ADMIN_USERNAME=@ADMIN_USUARIO@
ADMIN_EMAIL=@ADMIN_EMAIL@
ADMIN_PASSWORD=@GERAR_SENHA@

SMTP_HOST=@SMTP_HOST@
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_REMETENTE=PetConnect <nao-responda@@DOMINIO@>

# ---------------------------------------------------------------- limites de recurso (por instância)
API_CPUS=1.5
WEB_CPUS=1.0
MYSQL_CPUS=1.5
MONGO_CPUS=1.0
CADDY_CPUS=0.5

# ---------------------------------------------------------------- operação
SMOKE_USERNAME=smoke.deploy
SMOKE_PASSWORD=@GERAR_SENHA@
# Sem esta frase não há restore. Cada cliente tem a sua; guarde no cofre, separada das dos outros.
BACKUP_PASSPHRASE=@GERAR@
# BACKUP_DIR é definido pelo cliente.sh (clientes/<id>/backups). Cópia off-site: um destino por cliente.
BACKUP_REMOTO=
ALERTA_WEBHOOK_URL=
