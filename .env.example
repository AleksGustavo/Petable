# Copie para .env (não versionado) e troque TODOS os valores.
APP_ENV=dev

MYSQL_USER=petconnect
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# >= 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Primeiro administrador (criado só se ainda não existir nenhum ADMIN).
# A senha precisa atender à política: 10–72 caracteres, maiúscula, minúscula, número e especial.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@petconnect.local
ADMIN_PASSWORD=Troque-Esta-Senha-2026

# Portas no host (mude se alguma já estiver ocupada na sua máquina).
API_PORT=8081
WEB_PORT=3000
MYSQL_PORT=3307
MONGO_PORT=27019

# E-mail (recuperação de senha). No compose o padrão é o Mailpit (http://localhost:8025).
# Produção: SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SMTP_AUTH=true, SMTP_STARTTLS=true.
EMAIL_REMETENTE=PetConnect Web <nao-responda@petconnect.local>
# URL pública do frontend, usada nos links enviados por e-mail.
APP_FRONTEND_URL=http://localhost:3000
MAILPIT_PORT=8025

# ---------------------------------------------------------------- migração do legado (etapa 08)
# Só usados com: docker compose --profile migracao ... (ver docs/migracao-legado.md).
# Usuário do banco legado SÓ COM SELECT — a migração nunca escreve no sistema antigo.
LEGADO_DB_USERNAME=legado_read
LEGADO_DB_PASSWORD=troque-esta-senha-de-leitura
LEGADO_ROOT_PASSWORD=troque-esta-senha-root-legado
LEGADO_PORT=3308
# Padrão: esquema de teste + fixture SINTÉTICA. Para o dump real (nunca versionado):
# LEGADO_SCHEMA_SQL=./docker/migracao/vazio.sql
# LEGADO_DADOS_SQL=./docker/migracao/dados-reais/petshop_db.sql
# true = simulação (padrão). A execução real exige MIGRACAO_DRY_RUN=false explícito.
MIGRACAO_DRY_RUN=true
MIGRACAO_LOTE=500
# Pasta do host com os uploads do PHP (ex.: ./docker/migracao/dados-reais/fotos). Vazio = sem fotos.
MIGRACAO_FOTOS_DIR=
# Enriquecer cidade/UF pelo CEP (serviço externo; falha não interrompe).
MIGRACAO_VIACEP=false
# Forma de pagamento assumida para os serviços antigos (DINHEIRO, PIX, ...). Vazio = ficam pendentes.
MIGRACAO_BACKFILL_SERVICO_FORMA=
